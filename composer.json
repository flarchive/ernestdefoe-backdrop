{
    "name": "ernestdefoe/backdrop",
    "description": "Profile covers for Flarum 2: upload, drag to frame, zoom. On profiles, hover cards and the member directory, without patching anything other extensions rely on.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "profile",
        "cover",
        "banner"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ernestdefoe/backdrop/issues",
        "source": "https://github.com/ernestdefoe/backdrop"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "conflict": {
        "tryhackx/flarum-cover-studio": "*",
        "sycho/flarum-profile-cover": "*"
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Backdrop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Backdrop\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Backdrop",
            "category": "feature",
            "icon": {
                "name": "fas fa-panorama",
                "backgroundColor": "#0f766e",
                "color": "#fff"
            },
            "optional-dependencies": [
                "fof-upload"
            ]
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0",
        "fof/upload": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "suggest": {
        "fof/upload": "Member covers then go through FoF Upload: its storage, resizing, watermark and WebP thumbnails, in their My Media."
    }
}
